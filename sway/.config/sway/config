# Sway config — migrated from Hyprland (JaKooLit dots)
# https://github.com/swaywm/sway/wiki

### Variables ###
set $mod Mod4
set $term kitty
set $files kitty -e yazi
set $scriptsDir $HOME/.config/sway/scripts
set $menu rofi -show drun -modi drun,filebrowser,run,window

### Output / Monitor ###
# KTC H34S18S ultrawide on DP-2: 3440x1440 @ 165Hz, 1.25 scale
# Run `swaymsg -t get_outputs` to confirm the output name on the new machine
output DP-2 resolution 3440x1440@165Hz scale 1.25

### Input ###
input type:keyboard {
    xkb_layout us
    repeat_rate 50
    repeat_delay 300
    xkb_numlock enabled
}

input type:touchpad {
    dwt enabled
    natural_scroll enabled
    tap enabled
    click_method clickfinger
    drag enabled
    drag_lock disabled
    middle_emulation disabled
}

### Appearance ###
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
gaps inner 3
gaps outer 3
smart_gaps off
smart_borders off
font pango:JetBrainsMono Nerd Font 10
focus_follows_mouse yes
mouse_warping none
floating_modifier $mod normal
workspace_back_and_forth yes

### Colors (Catppuccin Mocha — matches UserDecorations.conf) ###
# class                 border    bg        text      indicator child_border
client.focused          #cba6f7   #1e1e2e   #cdd6f4   #cba6f7   #cba6f7
client.focused_inactive #45475a   #1e1e2e   #cdd6f4   #45475a   #45475a
client.unfocused        #313244   #1e1e2e   #6c7086   #313244   #313244
client.urgent           #f38ba8   #1e1e2e   #cdd6f4   #f38ba8   #f38ba8
client.placeholder      #313244   #1e1e2e   #cdd6f4   #313244   #313244

### Startup ###
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK
exec udiskie
exec nm-applet --indicator
exec swaync
exec waybar
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec swayidle -w \
    timeout 300  'swaylock --config $HOME/.config/sway/swaylock.conf' \
    timeout 360  'swaymsg "output * power off"' \
    resume       'swaymsg "output * power on"' \
    timeout 420  'systemctl suspend' \
    before-sleep 'swaylock --config $HOME/.config/sway/swaylock.conf'
exec blueman-applet
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

### ─── Keybindings ─── ###

## Application Launchers
bindsym $mod+Return  exec $term
bindsym $mod+q       exec $term
bindsym $mod+e       exec $files
bindsym $mod+d       exec $menu
bindsym $mod+b       exec xdg-open "https://"
bindsym $mod+n       exec kitty -e nvim
bindsym $mod+s       exec $scriptsDir/RofiSearch.sh
bindsym $mod+Ctrl+s  exec rofi -show window

## Window Management
bindsym $mod+c           kill
bindsym $mod+Shift+c     kill
bindsym $mod+Shift+f     fullscreen
bindsym $mod+f           fullscreen
bindsym $mod+space       floating toggle
bindsym $mod+Alt+space   exec swaymsg [workspace=__focused__] floating enable
bindsym $mod+p           sticky toggle

## Sway System
bindsym $mod+Shift+r    reload
bindsym Ctrl+Alt+Delete exec swaymsg exit

## Layout
# $mod+G → tabbed layout (approximates Hyprland groups)
bindsym $mod+g     layout tabbed
bindsym $mod+Alt+l layout toggle split

## Focus (HJKL + arrow keys)
bindsym $mod+h     focus left
bindsym $mod+j     focus down
bindsym $mod+k     focus up
bindsym $mod+l     focus right
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right
bindsym Alt+Tab    focus next sibling

## Move Windows (Ctrl+hjkl / arrows)
bindsym $mod+Ctrl+h     move left
bindsym $mod+Ctrl+j     move down
bindsym $mod+Ctrl+k     move up
bindsym $mod+Ctrl+l     move right
bindsym $mod+Ctrl+Left  move left
bindsym $mod+Ctrl+Down  move down
bindsym $mod+Ctrl+Up    move up
bindsym $mod+Ctrl+Right move right

## Swap Windows (Alt+hjkl / arrows)
bindsym $mod+Alt+h     move left
bindsym $mod+Alt+j     move down
bindsym $mod+Alt+k     move up
bindsym $mod+Alt+l     move right
bindsym $mod+Alt+Left  move left
bindsym $mod+Alt+Down  move down
bindsym $mod+Alt+Up    move up
bindsym $mod+Alt+Right move right

## Resize Windows
bindsym $mod+Shift+Left  resize shrink width  50px
bindsym $mod+Shift+Right resize grow   width  50px
bindsym $mod+Shift+Up    resize shrink height 50px
bindsym $mod+Shift+Down  resize grow   height 50px

## Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move window to workspace (follow)
bindsym $mod+Shift+1 move container to workspace number 1;  workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2;  workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3;  workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4;  workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5;  workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6;  workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7;  workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8;  workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9;  workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10; workspace number 10

# Move window to workspace silently (no follow)
bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9
bindsym $mod+Ctrl+0 move container to workspace number 10

# Cycle workspaces
bindsym $mod+Tab             workspace next_on_output
bindsym $mod+Shift+Tab       workspace prev_on_output
bindsym $mod+period          workspace next_on_output
bindsym $mod+comma           workspace prev_on_output
bindsym $mod+bracketright    workspace next_on_output
bindsym $mod+bracketleft     workspace prev_on_output
bindsym $mod+Shift+bracketright move container to workspace next_on_output; workspace next_on_output
bindsym $mod+Shift+bracketleft  move container to workspace prev_on_output; workspace prev_on_output

# Scroll through workspaces
bindsym --whole-window $mod+button4 workspace next_on_output
bindsym --whole-window $mod+button5 workspace prev_on_output

# Move workspace to monitor
bindsym $mod+Ctrl+F9  move workspace to output left
bindsym $mod+Ctrl+F10 move workspace to output right
bindsym $mod+Ctrl+F11 move workspace to output up
bindsym $mod+Ctrl+F12 move workspace to output down

## Scratchpad (Hyprland special workspace equivalent)
bindsym $mod+u       scratchpad show
bindsym $mod+Shift+u move scratchpad

## Drop-down Terminal
bindsym $mod+Shift+Return exec $scriptsDir/Dropterminal.sh "$term"

## Waybar
bindsym $mod+Ctrl+Alt+b exec pkill -SIGUSR1 waybar
bindsym $mod+Ctrl+b     exec $scriptsDir/WaybarStyles.sh
bindsym $mod+Alt+b      exec $scriptsDir/WaybarLayout.sh

## Notifications
bindsym $mod+Shift+n exec swaync-client -t -sw

## Features
bindsym $mod+Alt+r   exec $scriptsDir/Refresh.sh
bindsym $mod+Alt+e   exec $scriptsDir/RofiEmoji.sh
bindsym $mod+Alt+v   exec $scriptsDir/ClipManager.sh
bindsym $mod+Alt+c   exec $scriptsDir/RofiCalc.sh
bindsym $mod+Shift+m exec $scriptsDir/RofiBeats.sh
bindsym $mod+w       exec $scriptsDir/WallpaperSelect.sh
bindsym $mod+Shift+w exec $scriptsDir/WallpaperEffects.sh
bindsym Ctrl+Alt+w   exec $scriptsDir/WallpaperRandom.sh
bindsym $mod+Shift+k exec $scriptsDir/KeyBinds.sh
bindsym $mod+Shift+g exec $scriptsDir/GameMode.sh
bindsym $mod+Shift+e exec $scriptsDir/Kool_Quick_Settings.sh

## Screenshots
bindsym $mod+Print            exec $scriptsDir/ScreenShot.sh --now
bindsym $mod+Shift+Print      exec $scriptsDir/ScreenShot.sh --area
bindsym $mod+Ctrl+Print       exec $scriptsDir/ScreenShot.sh --in5
bindsym $mod+Ctrl+Shift+Print exec $scriptsDir/ScreenShot.sh --in10
bindsym $mod+Shift+d          exec $scriptsDir/ScreenShot.sh --active
bindsym $mod+Shift+s          exec $scriptsDir/ScreenShot.sh --swappy

## Lock / Power
bindsym Ctrl+Alt+l exec $scriptsDir/LockScreen.sh
bindsym Ctrl+Alt+p exec $scriptsDir/Wlogout.sh

## Volume (--locked = works at lock screen)
bindsym --locked XF86AudioRaiseVolume exec $scriptsDir/Volume.sh --inc
bindsym --locked XF86AudioLowerVolume exec $scriptsDir/Volume.sh --dec
bindsym --locked XF86AudioMute        exec $scriptsDir/Volume.sh --toggle
bindsym --locked XF86AudioMicMute     exec $scriptsDir/Volume.sh --toggle-mic
bindsym --locked $mod+F3              exec $scriptsDir/Volume.sh --inc
bindsym --locked $mod+F2              exec $scriptsDir/Volume.sh --dec
bindsym --locked $mod+F1              exec $scriptsDir/Volume.sh --toggle

## Media
bindsym --locked XF86AudioPlayPause exec $scriptsDir/MediaCtrl.sh --pause
bindsym --locked XF86AudioPause     exec $scriptsDir/MediaCtrl.sh --pause
bindsym --locked XF86AudioPlay      exec $scriptsDir/MediaCtrl.sh --pause
bindsym --locked XF86AudioNext      exec $scriptsDir/MediaCtrl.sh --nxt
bindsym --locked XF86AudioPrev      exec $scriptsDir/MediaCtrl.sh --prv
bindsym --locked XF86AudioStop      exec $scriptsDir/MediaCtrl.sh --stop

## Brightness
bindsym --locked XF86MonBrightnessUp   exec $scriptsDir/Brightness.sh --inc
bindsym --locked XF86MonBrightnessDown exec $scriptsDir/Brightness.sh --dec

