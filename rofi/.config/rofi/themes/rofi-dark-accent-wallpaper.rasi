/* ---- 💫 https://github.com/JaKooLit 💫 ---- */
/* Wallpaper selector — card thumbnails, Catppuccin Mocha */

configuration {
    show-icons:          true;
    display-drun:        "";
    drun-display-format: "{name}";
}

* {
    BG:  #1e1e2eff;
    BGA: #cba6f7ff;
    FG:  #cdd6f4ff;
    BDR: #cba6f7ff;
    SEL: #11111bff;
    SRF: #313244ff;
    OVR: #7f849cff;
    CRD: #181825ff;
    font: "JetBrainsMono Nerd Font 11";
}

window {
    transparency:     "real";
    background-color: @BG;
    text-color:       @FG;
    border:           2px solid;
    border-color:     @BDR;
    border-radius:    12px;
    width:            60%;
    height:           75%;
    anchor:           center;
    x-offset:         0;
    y-offset:         0;
}

mainbox {
    background-color: @BG;
    spacing:          10px;
    padding:          15px;
    children:         [ inputbar, listview ];
}

inputbar {
    children:         [ entry ];
    background-color: @SRF;
    text-color:       @FG;
    border:           0px 0px 2px 0px;
    border-color:     @BDR;
    border-radius:    8px;
    padding:          8px 12px;
}

entry {
    background-color: transparent;
    text-color:       @FG;
    placeholder-color: @OVR;
    expand:           true;
    horizontal-align: 0;
    placeholder:      "Search wallpapers...";
    blink:            true;
}

listview {
    background-color: @BG;
    columns:          1;
    lines:            6;
    spacing:          6px;
    cycle:            true;
    dynamic:          true;
    scrollbar:        true;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
}

scrollbar {
    border:           0px;
    border-radius:    4px;
    background-color: @SRF;
    handle-color:     @BGA;
    handle-width:     4px;
    padding:          0;
}

/* Regular selectable entries — card style */
element {
    background-color: @CRD;
    text-color:       @FG;
    orientation:      horizontal;
    border-radius:    10px;
    border:           1px solid;
    border-color:     @SRF;
    padding:          8px 12px;
    cursor:           pointer;
    spacing:          14px;
}

element selected {
    background-color: @SRF;
    border-color:     @BGA;
    text-color:       @FG;
}

/* Non-selectable section headers — flush, accent underline */
element normal.normal {
    background-color: @CRD;
    text-color:       @FG;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
    size:             80px;
    border:           0px;
    border-radius:    6px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    expand:           true;
    horizontal-align: 0;
    vertical-align:   0.5;
}

message { enabled: false; }
error-message {
    padding:          10px;
    border-radius:    8px;
    background-color: @BG;
    text-color:       @FG;
}
