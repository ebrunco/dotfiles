/**
 * Style 2: Dark Background with accent
 * Dark bg with purple accent to complement the Catppuccin palette
 * No external imports needed
 **/

configuration {
	modi:                       "drun,run";
    show-icons:                 false;
    display-drun:               "";
    display-run:                "";
	drun-display-format:        "{name}";
}

* {
    background-colour:           #1e1e2e;    /* base */
    foreground-colour:           #cdd6f4;    /* text */
    border-colour:               #cba6f7;    /* mauve */
    selected-background:         #302050;    /* subtle purple tint */
    selected-foreground:         #cba6f7;    /* mauve */
    normal-foreground:           #cdd6f4;
    muted-foreground:            #6c7086;    /* overlay0 */
    font:                        "JetBrainsMono Nerd Font 11";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       380px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               12px;
    border-color:                @border-colour;
    cursor:                      "default";
    background-color:            @background-colour;
}

mainbox {
    enabled:                     true;
    spacing:                     8px;
    padding:                     20px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    enabled:                     true;
    spacing:                     8px;
    padding:                     8px 12px;
    border:                      1px solid;
    border-radius:               8px;
    border-color:                @border-colour;
    background-color:            #252535;
    text-color:                  @foreground-colour;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  @border-colour;
}
entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "search...";
    placeholder-color:           @muted-foreground;
}
num-filtered-rows { enabled: false; }
textbox-num-sep   { enabled: false; }
num-rows          { enabled: false; }
case-indicator    { enabled: true; background-color: inherit; text-color: @border-colour; }

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     4px;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      "default";
}

element {
    enabled:                     true;
    spacing:                     8px;
    padding:                     8px 12px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @foreground-colour;
    cursor:                      pointer;
}
element normal.normal   { background-color: transparent;         text-color: @normal-foreground; }
element selected.normal { background-color: @selected-background; text-color: @selected-foreground; }
element alternate.normal{ background-color: transparent;         text-color: @normal-foreground; }
element-icon { background-color: transparent; text-color: inherit; size: 24px; cursor: inherit; }
element-text { background-color: transparent; text-color: inherit; highlight: inherit; cursor: inherit; vertical-align: 0.5; horizontal-align: 0.0; }

mode-switcher {
    enabled:                     false;
    spacing:                     8px;
    background-color:            transparent;
    text-color:                  @foreground-colour;
}
button {
    padding:                     6px 12px;
    border:                      1px solid;
    border-radius:               8px;
    border-color:                @border-colour;
    background-color:            #252535;
    text-color:                  inherit;
    cursor:                      pointer;
}
button selected {
    background-color:            @selected-background;
    text-color:                  @selected-foreground;
}

message { enabled: false; }
error-message {
    padding:                     10px;
    border-radius:               8px;
    background-color:            @background-colour;
    text-color:                  @foreground-colour;
}
